class Solution:
    def lemonadeChange(self, bills: List[int]) -> bool:
        a=0
        b=0
        c=0
        for i in range(len(bills)):
            if bills[i]==5:
                c+=1
            elif bills[i]==10:
                if c>0:
                    a+=1
                    c-=1
                else:
                    return 0
            elif bills[i]==20:
                if c>=1 and a>=1 :
                    b+=1
                    c-=1
                    a-=1
                elif c>=3:
                    c-=3
                else:
                    return 0
        return True
        
